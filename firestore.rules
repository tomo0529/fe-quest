rules_version = '2';

// FE QUEST : Firebase コンソール → Firestore Database → ルール に貼って「公開」
// ★ 下の INVITE_CODE を好きな合言葉に変えてから公開すること
service cloud.firestore {
  match /databases/{database}/documents {

    function INVITE_CODE() { return 'CHANGE-ME'; }

    function signedIn() { return request.auth != null; }

    // 招待コード付きでプロフィールを作った人だけがメンバー
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }

    // 日本時間で「今日」か「昨日」だけ記録できる（過去の水増し防止）
    function isDayFormat(day) {
      return day is string && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function isRecentDay(day) {
      let p = day.split('-');
      let d = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      let jst = request.time + duration.value(9, 'h');
      let t = timestamp.date(jst.year(), jst.month(), jst.day());
      return d == t || d == t - duration.value(1, 'd');
    }
    function validDay(day) { return isDayFormat(day) && isRecentDay(day); }

    function validProfile(d) {
      return d.keys().hasOnly(['username', 'examDate', 'createdAt', 'invite'])
        && d.username is string && d.username.size() >= 1 && d.username.size() <= 16
        && (d.examDate == null || isDayFormat(d.examDate));
    }

    match /profiles/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isMember();
      allow list: if isMember();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.invite == INVITE_CODE()
        && validProfile(request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.invite == resource.data.invite
        && validProfile(request.resource.data);
    }

    match /checkins/{id} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.keys().hasOnly(['uid', 'day', 'tags'])
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.day
        && validDay(request.resource.data.day)
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 3;
      allow delete: if isMember()
        && resource.data.uid == request.auth.uid
        && validDay(resource.data.day);
    }
  }
}
